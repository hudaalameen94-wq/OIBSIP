<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/calc_background"
    android:padding="12dp">

    <!-- Display -->
    <TextView
        android:id="@+id/textField"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/calc_background"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:padding="16dp"
        android:textColor="@color/calc_text_white"
        android:textSize="48sp"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeMaxTextSize="48sp" />

    <!-- Button grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:layout_marginTop="12dp"
        android:columnCount="4"
        android:rowCount="5">

        <!-- Row 1 -->
        <Button android:id="@+id/btnClr" android:text="C"
            style="@style/CalcButtonFunction" />
        <Button android:id="@+id/btnDel" android:text="⌫"
            style="@style/CalcButtonFunction" />
        <Button android:id="@+id/btnNeg" android:text="(-)"
            style="@style/CalcButtonFunction" />
        <Button android:id="@+id/btnDiv" android:text="÷"
            style="@style/CalcButtonOperator" />

        <!-- Row 2 -->
        <Button android:id="@+id/btn7" android:text="7" style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btn8" android:text="8" style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btn9" android:text="9" style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btnMul" android:text="×" style="@style/CalcButtonOperator" />

        <!-- Row 3 -->
        <Button android:id="@+id/btn4" android:text="4" style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btn5" android:text="5" style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btn6" android:text="6" style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btnSub" android:text="−" style="@style/CalcButtonOperator" />

        <!-- Row 4 -->
        <Button android:id="@+id/btn1" android:text="1" style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btn2" android:text="2" style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btn3" android:text="3" style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btnAdd" android:text="+" style="@style/CalcButtonOperator" />

        <!-- Row 5 -->
        <Button android:id="@+id/btn0" android:text="0"
            android:layout_columnSpan="2"
            style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btnDec" android:text="." style="@style/CalcButtonNumber" />
        <Button android:id="@+id/btnEqu" android:text="=" style="@style/CalcButtonOperator" />
    </GridLayout>
</LinearLayout>